{
	"name": "ls_sqlsrvr_dyn_ss",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"srvrName": {
				"type": "string",
				"defaultValue": "AaryanSharif\\SHARIF"
			},
			"dbName": {
				"type": "string",
				"defaultValue": "AdventureWorkMock"
			},
			"usrName": {
				"type": "string",
				"defaultValue": "sharif"
			},
			"scrName": {
				"type": "string",
				"defaultValue": "sharif"
			}
		},
		"annotations": [],
		"type": "SqlServer",
		"typeProperties": {
			"server": "@{linkedService().srvrName}",
			"database": "@{linkedService().dbName}",
			"encrypt": "mandatory",
			"trustServerCertificate": true,
			"authenticationType": "SQL",
			"userName": "@{linkedService().usrName}",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_adwm_kv",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().scrName",
					"type": "Expression"
				}
			}
		}
	}
}