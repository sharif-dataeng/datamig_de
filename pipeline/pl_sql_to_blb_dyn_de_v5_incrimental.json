{
	"name": "pl_sql_to_blb_dyn_de_v5_incrimental",
	"properties": {
		"description": "this pipeline will copy data from onprime sql server to gen2 blob storage dynamically.",
		"activities": [
			{
				"name": "LookupTable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT * FROM ',\n    pipeline().parameters.schName, '.', pipeline().parameters.tblName,\n    ' WHERE isactive = ''Y'''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sqlsrvr_dyn_de",
						"type": "DatasetReference",
						"parameters": {
							"tblName": {
								"value": "@pipeline().parameters.tblName",
								"type": "Expression"
							},
							"schName": {
								"value": "@pipeline().parameters.schName",
								"type": "Expression"
							},
							"srvrName": {
								"value": "@pipeline().parameters.srvrName",
								"type": "Expression"
							},
							"dbName": {
								"value": "@pipeline().parameters.dbName",
								"type": "Expression"
							},
							"usrName": {
								"value": "@pipeline().parameters.usrName",
								"type": "Expression"
							},
							"scrName": {
								"value": "@pipeline().parameters.scrName",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LookupTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupTable').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().loadtype,'F')\n",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy data incremental",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderQuery": "@concat(\n    'SELECT * FROM ',\n    item().schemaname, '.', item().tablename,\n    ' WHERE ',\n    item().watermark,\n    ' > ''',\n    item().loadedon,\n    ''''\n)",
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "ds_sqlsrvr_dyn_de",
												"type": "DatasetReference",
												"parameters": {
													"tblName": {
														"value": "@item().tablename",
														"type": "Expression"
													},
													"schName": {
														"value": "@item().schemaname",
														"type": "Expression"
													},
													"srvrName": {
														"value": "@pipeline().parameters.srvrName",
														"type": "Expression"
													},
													"dbName": {
														"value": "@pipeline().parameters.dbName",
														"type": "Expression"
													},
													"usrName": {
														"value": "@pipeline().parameters.usrName",
														"type": "Expression"
													},
													"scrName": {
														"value": "@pipeline().parameters.scrName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_adlsgen2_dyn_de",
												"type": "DatasetReference",
												"parameters": {
													"strgName": "@pipeline().parameters.strgName",
													"pathName": {
														"value": "@concat(pipeline().parameters.usrName,'/',pipeline().parameters.dbName,'/',item().schemaname,'/','incremental','/',item().tablename)",
														"type": "Expression"
													},
													"fileName": "@concat(item().tablename,'_', formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.csv')"
												}
											}
										]
									},
									{
										"name": "update on incr load success",
										"type": "Script",
										"dependsOn": [
											{
												"activity": "Copy data incremental",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "ls_sqlsrvr_dyn_de",
											"type": "LinkedServiceReference",
											"parameters": {
												"srvrName": {
													"value": "@pipeline().parameters.srvrName",
													"type": "Expression"
												},
												"dbName": {
													"value": "@pipeline().parameters.dbName",
													"type": "Expression"
												},
												"usrName": {
													"value": "@pipeline().parameters.usrName",
													"type": "Expression"
												},
												"scrName": {
													"value": "@pipeline().parameters.scrName",
													"type": "Expression"
												}
											}
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "NonQuery",
													"text": {
														"value": "@concat(\r\n    'UPDATE ',\r\n    pipeline().parameters.schName, '.', pipeline().parameters.tblName,\r\n    ' SET loadedon = CURRENT_TIMESTAMP, loadstatus = ''success'' ',\r\n    'WHERE schemaname = ''', item().schemaname, ''' AND tablename = ''', item().tablename, ''''\r\n)",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
