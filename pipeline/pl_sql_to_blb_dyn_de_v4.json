{
	"name": "pl_sql_to_blb_dyn_de_v4",
	"properties": {
		"description": "this pipeline will copy data from on prime sql server to gen2 blob storage dynamically",
		"activities": [
			{
				"name": "Lookup Table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sqlsrvr_dyn_de",
						"type": "DatasetReference",
						"parameters": {
							"tblName": {
								"value": "@pipeline().parameters.tblName",
								"type": "Expression"
							},
							"schName": {
								"value": "@pipeline().parameters.schName",
								"type": "Expression"
							},
							"srvrName": {
								"value": "@pipeline().parameters.srvrName",
								"type": "Expression"
							},
							"dbName": {
								"value": "@pipeline().parameters.dbName",
								"type": "Expression"
							},
							"usrName": {
								"value": "@pipeline().parameters.usrName",
								"type": "Expression"
							},
							"scrName": {
								"value": "@pipeline().parameters.scrName",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Table').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().loadtype,'F')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Wait1",
										"type": "Wait",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"waitTimeInSeconds": 1
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy data1",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "ds_sqlsrvr_dyn_de",
												"type": "DatasetReference",
												"parameters": {
													"tblName": {
														"value": "@pipeline().parameters.tblName",
														"type": "Expression"
													},
													"schName": {
														"value": "@pipeline().parameters.schName",
														"type": "Expression"
													},
													"srvrName": {
														"value": "@pipeline().parameters.srvrName",
														"type": "Expression"
													},
													"dbName": {
														"value": "@pipeline().parameters.dbName",
														"type": "Expression"
													},
													"usrName": {
														"value": "@pipeline().parameters.usrName",
														"type": "Expression"
													},
													"scrName": {
														"value": "@pipeline().parameters.scrName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_adlsgen2_dyn_de",
												"type": "DatasetReference",
												"parameters": {
													"strgName": {
														"value": "@pipeline().parameters.strgName",
														"type": "Expression"
													},
													"pathName": {
														"value": "@concat(pipeline().parameters.usrName,'/',pipeline().parameters.dbName,'/',item().schemaname,'/',item().tablename)",
														"type": "Expression"
													},
													"fileName": {
														"value": "@concat(item().tablename,'_', formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.csv')",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"schName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"tblName": {
				"type": "string",
				"defaultValue": "DataLoad_Control"
			},
			"srvrName": {
				"type": "string",
				"defaultValue": "DELL"
			},
			"dbName": {
				"type": "string",
				"defaultValue": "AdventureWorkMock"
			},
			"usrName": {
				"type": "string",
				"defaultValue": "benarji"
			},
			"scrName": {
				"type": "string",
				"defaultValue": "benarji"
			},
			"strgName": {
				"type": "string",
				"defaultValue": "adwgen2"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-03-30T19:34:53Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}