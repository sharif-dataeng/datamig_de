{
	"name": "pl_onprime_to_cloud_sql_dyn_v1",
	"properties": {
		"description": "This pipeline will copy data from on-premises SQL Server to Gen2 Blob storage dynamically.",
		"activities": [
			{
				"name": "Lookup Table List",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sqlsrvr_dyn_ss",
						"type": "DatasetReference",
						"parameters": {
							"tblName": {
								"value": "@pipeline().parameters.s_tblName",
								"type": "Expression"
							},
							"schName": {
								"value": "@pipeline().parameters.s_schName",
								"type": "Expression"
							},
							"srvrName": {
								"value": "@pipeline().parameters.s_srvrName",
								"type": "Expression"
							},
							"dbName": {
								"value": "@pipeline().parameters.s_dbName",
								"type": "Expression"
							},
							"usrName": {
								"value": "@pipeline().parameters.s_usrName",
								"type": "Expression"
							},
							"scrName": {
								"value": "@pipeline().parameters.s_scrName",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup Table List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Table List').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": true,
								"secureInput": true
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate",
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": false,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_sqlsrvr_dyn_ss",
									"type": "DatasetReference",
									"parameters": {
										"tblName": {
											"value": "@item().tablename",
											"type": "Expression"
										},
										"schName": {
											"value": "@item().schemaname",
											"type": "Expression"
										},
										"srvrName": {
											"value": "@pipeline().parameters.s_srvrName",
											"type": "Expression"
										},
										"dbName": {
											"value": "@pipeline().parameters.s_dbName",
											"type": "Expression"
										},
										"usrName": {
											"value": "@pipeline().parameters.s_usrName",
											"type": "Expression"
										},
										"scrName": {
											"value": "@pipeline().parameters.s_scrName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_sqlsrvr_cld_dyn_ss",
									"type": "DatasetReference",
									"parameters": {
										"srvrName": {
											"value": "@pipeline().parameters.t_srvrName",
											"type": "Expression"
										},
										"dbName": {
											"value": "@pipeline().parameters.t_dbName",
											"type": "Expression"
										},
										"usrName": {
											"value": "@pipeline().parameters.t_usrName",
											"type": "Expression"
										},
										"scrName": {
											"value": "@pipeline().parameters.t_scrName",
											"type": "Expression"
										},
										"schName": {
											"value": "@item().schemaname",
											"type": "Expression"
										},
										"tblName": {
											"value": "@item().tablename",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"s_schName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"s_tblName": {
				"type": "string",
				"defaultValue": "DataLoad_Control"
			},
			"s_srvrName": {
				"type": "string",
				"defaultValue": "AaryanSharif\\SHARIF"
			},
			"s_dbName": {
				"type": "string",
				"defaultValue": "AdventureWorkMock"
			},
			"s_usrName": {
				"type": "string",
				"defaultValue": "sharif"
			},
			"s_scrName": {
				"type": "string",
				"defaultValue": "sharif"
			},
			"t_srvrName": {
				"type": "string",
				"defaultValue": "dev1db"
			},
			"t_dbName": {
				"type": "string",
				"defaultValue": "dev1db"
			},
			"t_usrName": {
				"type": "string",
				"defaultValue": "sharif"
			},
			"t_scrName": {
				"type": "string",
				"defaultValue": "sharif-cld"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-03-30T19:34:52Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}