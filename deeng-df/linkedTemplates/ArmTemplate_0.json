		{
			"name": "[concat(parameters('factoryName'), '/pl_onprime_to_cloud_sql_dyn')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "This pipeline will copy data from on-premises SQL Server to cloud sql server dynamically.",
				"activities": [
					{
						"name": "Lookup Table List",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": {
									"value": "@concat(\n  'SELECT * FROM ',\n  pipeline().parameters.s_schName,\n  '.',\n  pipeline().parameters.s_tblName,\n  ' WHERE isactive = ''Y'''\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sqlsrvr_dyn_ss",
								"type": "DatasetReference",
								"parameters": {
									"tblName": {
										"value": "@pipeline().parameters.s_tblName",
										"type": "Expression"
									},
									"schName": {
										"value": "@pipeline().parameters.s_schName",
										"type": "Expression"
									},
									"srvrName": {
										"value": "@pipeline().parameters.s_srvrName",
										"type": "Expression"
									},
									"dbName": {
										"value": "@pipeline().parameters.s_dbName",
										"type": "Expression"
									},
									"usrName": {
										"value": "@pipeline().parameters.s_usrName",
										"type": "Expression"
									},
									"scrName": {
										"value": "@pipeline().parameters.s_scrName",
										"type": "Expression"
									}
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEachTable",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup Table List",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup Table List').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "If Condition1",
									"type": "IfCondition",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@equals(item().loadtype,'F')",
											"type": "Expression"
										},
										"ifFalseActivities": [
											{
												"name": "Copy_Incr_Load",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": true,
													"secureInput": true
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "SqlServerSource",
														"sqlReaderQuery": {
															"value": "@concat(\n  'SELECT * FROM ',\n  item().schemaname,\n  '.',\n  item().tablename,\n  ' WHERE ',\n  item().watermark,\n  ' > ''',\n  item().loadedon,\n  ''''\n)",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "AzureSqlSink",
														"writeBehavior": "upsert",
														"upsertSettings": {
															"useTempDB": true,
															"keys": {
																"value": "@split(item().keycolumns, ',')",
																"type": "Expression"
															}
														},
														"sqlWriterUseTableLock": false,
														"tableOption": "autoCreate",
